{
  "name": "constella",
  "version": "0.11.3",
  "description": "Explore your vault as an interactive, local-first knowledge graph.",
  "main": "main.js",
  "scripts": {
    "test": "node --test scripts/test-*.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "version:check": "node scripts/check-version.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "graph",
    "visualization"
  ],
  "author": "loopman90",
  "license": "MIT",
  "overrides": {
    "moment": "2.31.0"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.7",
    "tslib": "^2.8.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "d3-force": "^3.0.0"
  }
}
